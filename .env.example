# 可选：系统环境变量已设置就不用建本文件。
# 同名系统变量优先级更高，会覆盖这里的值。
#
# 云端 API（默认）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
CHROMA_PATH=./chroma_db

# 向量库模式：embedded（默认）或 server（配合 chroma run）
CHROMA_MODE=embedded
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# ---- 下面前往本机自托管模型时再填（见 docs/LOCAL_DEPLOY.md）----
# Embedding（OpenAI 兼容 /embeddings，换模型必须重建向量库）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# OCR（扫描版 PDF / 图片；留空 = 不启用）
OCR_BASE_URL=
OCR_DPI=300

# 网关上游（只有 gateway 读）
UPSTREAM_LLM=
UPSTREAM_LLM_KEY=
UPSTREAM_EMBED=
UPSTREAM_EMBED_KEY=
UPSTREAM_OCR=
GATEWAY_ADMIN_TOKEN=
# 同一 Key 最多几个在途请求（防单个项目占满模型并发槽）；0 = 不限
GATEWAY_KEY_CONCURRENCY=2

# 本机部署脚本用（deploy/local/*.ps1）
MME_PORT_WEB=8300
MME_PORT_GATEWAY=8100
MME_PORT_OCR=8101
MME_PORT_EMBED=8002
MME_PORT_LLM=8010
MME_LLM_BIN=
MME_LLM_GGUF=
MME_LLM_ALIAS=qwen2.5-72b-instruct
MME_EMBED_GGUF=
MME_EMBED_POOLING=cls
# KV cache 量化：q8_0（省一半显存，需要 -fa）或 f16（老卡/排障时）
MME_LLM_KV=q8_0
# 并发槽数 / 总上下文（每槽 = MME_LLM_CTX / MME_LLM_NP） / 线程数
MME_LLM_NP=2
MME_LLM_CTX=65536
MME_LLM_THREADS=32
