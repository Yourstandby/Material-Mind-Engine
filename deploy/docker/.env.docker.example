# Docker 部署用配置（复制成仓库根目录的 .env.docker 后修改）
# 与原生部署的 .env 区别：主机名用容器名，而不是 127.0.0.1

# ===== MME 主程序（走容器内的网关）=====
OPENAI_BASE_URL=http://gateway:8100/v1
OPENAI_API_KEY=mme-请替换成 scripts.make_key 生成的 key
LLM_MODEL=qwen2.5-72b-instruct

EMBEDDING_BASE_URL=http://gateway:8100/v1
EMBEDDING_API_KEY=mme-同上
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

CHROMA_MODE=embedded
CATALOG_COLLECTION=catalog

OCR_BASE_URL=http://ocr:8101
OCR_DPI=300

# ===== 网关上游 =====
# 宿主机上的推理服务；Linux 用 host.docker.internal 或直接写内网 IP
UPSTREAM_LLM=http://host.docker.internal:8010/v1
UPSTREAM_LLM_KEY=
GATEWAY_ADMIN_TOKEN=换成一串随机字符

# ===== compose 用 =====
MODELS_DIR=/opt/models
