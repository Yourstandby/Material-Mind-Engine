# 局域网内其他项目接入 MME 模型服务的配置（模板，可提交）
# 真实值在 mme-client.env（已被 .gitignore 排除）

MME_BASE_URL=http://<MME服务器IP>:8100/v1
MME_API_KEY=mme-<到 deploy/local 用 scripts.make_key 生成>

MME_LLM_MODEL=qwen2.5-72b-instruct

MME_EMBED_MODEL=bge-m3
MME_EMBED_DIM=1024

MME_OCR_URL=http://<MME服务器IP>:8100/ocr

# MME_ADMIN_URL=http://<MME服务器IP>:8100/admin/usage?hours=24
# MME_ADMIN_TOKEN=<GATEWAY_ADMIN_TOKEN>
